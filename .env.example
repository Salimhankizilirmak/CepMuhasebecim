# Vercel > Project > Settings > Environment Variables bölümüne girilecek değerler.
# Bu dosyayı .env olarak kopyalayıp doldurmana gerek yok; değerleri Vercel paneline gir.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" anahtar (herkese açık olabilir)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # "service_role" anahtar — GİZLİ, kimseyle paylaşma

# Google AI Studio > Get API key
GEMINI_API_KEY=AIza...
# İsteğe bağlı: varsayılan gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# İsteğe bağlı: kullanıcı başına günlük asistan sorusu (varsayılan 40)
# AI_GUNLUK_LIMIT=40

# Aylık otomatik faiz güncellemesini yalnızca Vercel'in tetikleyebilmesi için rastgele uzun bir metin
CRON_SECRET=uzun-rastgele-bir-metin

# İsteğe bağlı: TCMB EVDS (https://evds2.tcmb.gov.tr > Profil > API Anahtarı)
# EVDS_API_KEY=
# EVDS_IHTIYAC_SERIES=TP.KTF10
